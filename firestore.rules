rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ── Businesses (also used for Events with category="Event") ──
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;

      // ── Business activity log (chat notifications, etc.) ──
      // Only the business owner can read their own activity feed. Writes
      // happen via sendMessage() in the app using the owner's/customer's
      // own auth context, not directly by an arbitrary third party.
      match /activityLog/{entryId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      // ── Event ticket tiers ──
      // Read must be public (pricing needs to be visible pre-purchase).
      // Write restricted to the event's owner/organizer only.
      // Sold-count increments should move to a Cloud Function once
      // ticket purchases move server-side.
      match /tickets/{ticketId} {
        allow read: if true;
        allow create: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
        allow update: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
        allow delete: if request.auth != null && (
          get(/databases/$(database)/documents/businesses/$(businessId)).data.organizerId == request.auth.uid ||
          get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
      }
    }

    // ── Chats (business <-> customer messaging) ──
    // Uses a `participants` array [customerId, businessOwnerId] so both
    // parties can read/write. Security rules check `auth.uid in participants`.
    match /chats/{chatId} {
      allow read, write: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
        );
      }
    }

    // ── Purchased ticket records (top-level, separate from the tier
    // inventory subcollection above) ──
    // NOTE: no write path to this collection exists anywhere in the client
    // codebase as of this writing — EventTicketsPage.tsx only ever READS
    // from it (querying sales counts). This means either ticket purchases
    // aren't actually being recorded here yet (a real gap to close before
    // "tickets sold" figures can be trusted), or they're written through a
    // mechanism not yet found in this codebase. Read is allowed broadly for
    // now so the existing sales-count queries don't break; revisit the
    // write rule once the actual purchase-recording flow is confirmed.
    match /tickets/{ticketRecordId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Marketplace Products ──
    match /marketplace/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── House Listings / Properties ──
    match /house_listings/{listingId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Events ──
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Favourites ──
    match /favourites/{favouriteId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Wallets ──
    match /wallets/{walletId} {
      allow read: if request.auth != null && request.auth.uid == walletId;
      allow create: if request.auth != null && request.auth.uid == walletId;
      allow update: if request.auth != null && request.auth.uid == walletId;
      allow delete: if false;

      // ── Wallet transaction history ──
      // Only the wallet owner can read their own transaction history.
      // Admin aggregation should use a Cloud Function with Admin SDK
      // (bypasses rules server-side) rather than a permissive client read.
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == walletId;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Transactions (legacy top-level) ──
    match /transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // ── Ads ──
    match /ads/{adId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Feedback ──
    match /feedback/{feedbackId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Reviews ──
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Ticket Orders ──
    match /ticket_orders/{orderId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.buyerId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.ownerId == request.auth.uid
      );
    }

    // ── Property Bookings ──
    match /property_bookings/{bookingId} {
      allow read: if request.auth != null && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.payerId == request.auth.uid ||
        resource.data.guestEmail == request.auth.token.email
      );
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // ── Activity Logs ──
    match /activity_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Catch-all: deny everything else ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
